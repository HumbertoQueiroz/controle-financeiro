# Copie para .env e ajuste. O .env NUNCA é commitado.

# ---------- Banco ----------
POSTGRES_USER=controle
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=controle_financeiro
POSTGRES_PORT=5432

DATABASE_URL="postgresql://controle:troque-esta-senha@localhost:5432/controle_financeiro?schema=public"

# Banco de teste — sobe em porta própria, dados descartáveis
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL="postgresql://controle:troque-esta-senha@localhost:5433/controle_financeiro_test?schema=public"

# ---------- API ----------
NODE_ENV=development
API_PORT=3333
API_URL=http://localhost:3333

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-valor-aleatorio-de-48-bytes
COOKIE_SECRET=troque-por-outro-valor-aleatorio-de-48-bytes

# ---------- Web ----------
# Usada para montar o link do convite que vai por WhatsApp
APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:3333

# ---------- Seed do admin ----------
ADMIN_EMAIL=admin@controle.local
ADMIN_NAME=Administrador
# Se ficar em branco, o seed gera uma senha aleatória, imprime uma vez no console
# e marca o admin para trocar a senha no primeiro acesso.
ADMIN_PASSWORD=
