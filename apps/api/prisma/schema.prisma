// Modelo de dados do controle financeiro.
//
// A decisão central está em Obligation: "a pagar" e "a receber" são a MESMA linha vista
// das duas pontas, não duas tabelas. Duas tabelas divergem — um acerto lançado de um lado
// e esquecido do outro produz saldos que não fecham, e o erro só aparece no fechamento do
// mês. Com uma linha só, o relatório de quem deve e o de quem recebe leem a mesma verdade.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  USER
}

/// Escopo do que o dono dos dados autoriza um terceiro a enxergar.
enum GrantScope {
  PAYABLE
  RECEIVABLE
  BOTH
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum DocumentType {
  TERMS
  PRIVACY
}

/// Formas de pagamento que o README trata como relevantes ao domínio.
enum PaymentMethod {
  CASH
  BARTER
  MEAL_VOUCHER
  CREDIT_CARD
}

enum ObligationStatus {
  OPEN
  PARTIAL
  SETTLED
  CANCELLED
}

enum OriginType {
  /// A fatura inteira, devida pelo dono do cartão à instituição. É uma obrigação por
  /// fatura, não por compra: ninguém paga cada lançamento, paga a fatura na data dela.
  INVOICE
  /// Um lançamento repassado a terceiro — o que o dono tem a receber daquela pessoa.
  CARD_ENTRY
  GROUP_EXPENSE
  /// Parcela gerada por uma recorrência: salário, aluguel, assinatura.
  RECURRENCE
  /// Lançado à mão, avulso.
  MANUAL
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
}

enum SettlementStatus {
  OPEN
  CLOSED
}

// ---------------------------------------------------------------------------
// Identidade e permissão
// ---------------------------------------------------------------------------

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role      @default(USER)
  active             Boolean   @default(true)
  /// Marcado quando a senha foi gerada pelo sistema (seed) e precisa ser trocada.
  mustChangePassword Boolean   @default(false)
  anonymizedAt       DateTime?

  /// Próximo número de fechamento **deste** usuário.
  ///
  /// A numeração é por conta, e não global: "o fechamento nº 3" precisa ser um número que
  /// a pessoa reconheça nos próprios papéis, e um contador compartilhado faria os números
  /// dela saltarem conforme outros usuários fechassem contas.
  ///
  /// Incrementado com `increment` dentro da transação do fechamento — ler, somar e gravar
  /// daria o mesmo número a dois fechamentos simultâneos.
  nextSettlementNumber Int @default(1)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  /// Todas as fichas que apontam para esta conta: a espelho (onde `ownerId` é o próprio
  /// usuário) e uma em cada agenda alheia que o registrou. O relatório de alguém é a
  /// união das obrigações de todas elas — é o que faz uma dívida lançada por outra pessoa
  /// aparecer para quem deve.
  pessoasVinculadas Person[]         @relation("UsuarioDaPessoa")
  /// Pessoas que este usuário cadastrou (terceiros, que podem não ter conta).
  people           Person[]          @relation("PessoasDoUsuario")
  grantsGiven      ReportGrant[]     @relation("GrantsConcedidos")
  grantsReceived   ReportGrant[]     @relation("GrantsRecebidos")
  invitesSent      ReportInvite[]    @relation("ConvitesEnviados")
  invitesAccepted  ReportInvite[]    @relation("ConvitesAceitos")
  termsAcceptances TermsAcceptance[]
  cards            CreditCard[]
  groups           Group[]
  importBatches    ImportBatch[]
  recorrencias     Recurrence[]
  categorias       Category[]
  contas           BankAccount[]
  fechamentos      ParticipantSettlement[]
  agendasDeFechamento SettlementSchedule[]
  avisosLidos         NoticeRead[]

  @@index([email])
}

/// Contraparte de qualquer obrigação.
///
/// Resolve o "o terceiro pode ou não ser usuário do sistema" do README: a Person existe
/// sozinha, e quando aquela pessoa passa a ter conta o campo `userId` faz o vínculo —
/// que é o que permite a ela enxergar o que deve. Sem essa separação seria preciso obrigar
/// todo amigo de rolê a criar conta antes de a despesa poder ser registrada.
model Person {
  id           String    @id @default(uuid())
  name         String
  email        String?
  phone        String?
  /// Quem cadastrou esta pessoa e responde pelos dados dela perante a LGPD.
  ownerId      String
  /// Preenchido quando esta pessoa é (ou virou) usuária do sistema.
  ///
  /// NÃO é único global: a mesma conta aparece uma vez na agenda de cada dono que a
  /// registrou, além da ficha espelho dela própria. Unique global impediria a Ana de ter
  /// "Bruno do rolê" apontando para a conta do Bruno, já que o Bruno também tem a dele.
  userId       String?
  anonymizedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner User  @relation("PessoasDoUsuario", fields: [ownerId], references: [id], onDelete: Cascade)
  user  User? @relation("UsuarioDaPessoa", fields: [userId], references: [id], onDelete: SetNull)

  /// Uma ficha por conta dentro de cada agenda. Duas apontando para a mesma conta
  /// duplicariam o que ela deve, e o saldo dela apareceria dobrado.
  @@unique([ownerId, userId])

  convites              ReportInvite[]
  recorrencias          Recurrence[]
  obligationsAsDebtor   Obligation[]         @relation("Devedor")
  obligationsAsCreditor Obligation[]         @relation("Credor")
  forwardedEntries      InvoiceEntry[]
  parcelamentos         Installment[]
  groupMemberships      GroupMember[]
  expensesPaid          GroupExpense[]
  expenseShares         ExpenseShare[]
  transfersFrom         SettlementTransfer[] @relation("TransferenciaOrigem")
  transfersTo           SettlementTransfer[] @relation("TransferenciaDestino")
  fechamentos           ParticipantSettlement[]
  agendaDeFechamento    SettlementSchedule?

  @@index([ownerId])
  @@index([email])
}

/// O consentimento que libera um terceiro a ver o relatório de alguém.
///
/// Existe no máximo uma linha por par (dono, convidado): revogar preenche `revokedAt` e
/// conceder de novo limpa o campo. Guardar histórico como linhas novas faria a consulta
/// de permissão precisar escolher entre várias, e a consulta de permissão é o lugar onde
/// ambiguidade vira vazamento de dado.
model ReportGrant {
  id            String     @id @default(uuid())
  ownerId       String
  granteeUserId String
  scope         GrantScope
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  owner   User @relation("GrantsConcedidos", fields: [ownerId], references: [id], onDelete: Cascade)
  grantee User @relation("GrantsRecebidos", fields: [granteeUserId], references: [id], onDelete: Cascade)

  @@unique([ownerId, granteeUserId])
  @@index([granteeUserId])
}

/// Consentimento pendente, para quem ainda não tem conta.
///
/// O `scope` mora aqui dentro: é o que faz a permissão viajar embutida no convite e o
/// convidado já entrar enxergando o relatório, sem o dono precisar voltar para conceder.
/// Do token guarda-se apenas o hash — vazamento do banco não pode virar acesso a dado
/// financeiro de ninguém.
model ReportInvite {
  id               String       @id @default(uuid())
  ownerId          String
  email            String
  /// Opcional, e usado só para montar o link do WhatsApp que entrega o convite.
  phone            String?
  /// A Person do cadastro do dono que corresponde a quem foi convidado. Quando presente,
  /// o aceite vincula essa Person à conta criada — é assim que o convidado passa a ver
  /// as dívidas que já estavam lançadas em nome dele antes de ele ter conta.
  personId         String?
  scope            GrantScope
  tokenHash        String       @unique
  status           InviteStatus @default(PENDING)
  expiresAt        DateTime
  acceptedByUserId String?
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  owner      User    @relation("ConvitesEnviados", fields: [ownerId], references: [id], onDelete: Cascade)
  acceptedBy User?   @relation("ConvitesAceitos", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  person     Person? @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([ownerId, email])
  @@index([status])
}

/// Prova de aceite dos termos, exigida pela LGPD.
///
/// Uma linha por versão aceita, nunca sobrescrita: o histórico É a evidência de quando e
/// a que a pessoa consentiu. Guardar só "aceitou: sim" não demonstra nada depois que o
/// documento muda.
model TermsAcceptance {
  id           String       @id @default(uuid())
  userId       String
  documentType DocumentType
  version      String
  acceptedAt   DateTime     @default(now())
  ipAddress    String?
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, version])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Obrigações — a espinha dorsal dos relatórios
// ---------------------------------------------------------------------------

model Obligation {
  id String @id @default(uuid())

  /// Nulo quando a origem do dinheiro não é uma pessoa cadastrada — o caso do salário,
  /// em que o pagador é o empregador e obrigar a cadastrá-lo como pessoa seria atrito
  /// sem ganho. Ao menos um dos dois lados precisa existir (CHECK na migration).
  debtorId   String?
  /// Nulo quando a contraparte é a instituição do cartão, e não uma pessoa.
  creditorId String?
  /// Nome da contraparte quando ela não é uma Person: "Salário", "Aluguel", "Nubank".
  counterpartyLabel String?

  description   String
  amount        Decimal @db.Decimal(14, 2)
  settledAmount Decimal @default(0) @db.Decimal(14, 2)

  /// As duas datas que controlam todo lançamento financeiro.
  ///
  /// `dueDate` é quando vence; `settledAt` é quando de fato foi pago ou recebido — a
  /// baixa. Separá-las é o que permite distinguir "previsto" de "realizado": uma conta
  /// vencida em agosto e paga em setembro pertence ao orçamento de agosto e ao caixa de
  /// setembro, e com uma data só uma dessas leituras seria mentira.
  dueDate   DateTime
  settledAt DateTime?

  status        ObligationStatus @default(OPEN)
  paymentMethod PaymentMethod
  originType    OriginType
  /// Id do InvoiceEntry, da ExpenseShare ou da Invoice que originou esta obrigação.
  originId      String?

  /// Preenchidos nas parcelas geradas por uma recorrência. O par é único, e é ele que
  /// torna a geração do mês idempotente: abrir o orçamento duas vezes não duplica o salário.
  recurrenceId   String?
  referenceMonth String? @db.Char(7)

  /// Classificação do lançamento. Opcional: exigir categoria travaria o lançamento
  /// rápido, e um lançamento não feito é pior que um sem categoria.
  categoryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  debtor     Person?     @relation("Devedor", fields: [debtorId], references: [id], onDelete: Cascade)
  creditor   Person?     @relation("Credor", fields: [creditorId], references: [id], onDelete: Cascade)
  recurrence Recurrence? @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payments   Payment[]

  @@unique([recurrenceId, referenceMonth])
  @@index([debtorId, status])
  @@index([creditorId, status])
  @@index([originType, originId])
  @@index([dueDate])
  @@index([settledAt])
  @@index([categoryId, dueDate])
}

/// De que lado do caixa o lançamento está.
enum Direction {
  /// Entra dinheiro: salário, reembolso, venda.
  RECEIVABLE
  /// Sai dinheiro: aluguel, assinatura, fatura.
  PAYABLE
}

/// Lançamento que se repete todo mês — salário, aluguel, assinatura.
///
/// A recorrência é o molde, não o lançamento: as parcelas são obrigações de verdade,
/// criadas mês a mês. Guardar só o molde e calcular na hora de exibir impediria dar baixa
/// numa parcela, editar o valor de um mês específico, ou saber o que de fato aconteceu.
model Recurrence {
  id          String  @id @default(uuid())
  ownerUserId String
  /// A ficha do dono, que é quem recebe ou deve nas parcelas geradas.
  personId    String
  direction   Direction

  description       String
  amount            Decimal       @db.Decimal(14, 2)
  paymentMethod     PaymentMethod
  counterpartyLabel String?

  /// Dia do vencimento. Meses curtos usam o último dia disponível.
  dayOfMonth Int
  /// Categoria herdada pelas parcelas geradas.
  categoryId String?
  /// Vigência em YYYY-MM. Sem `endsOn`, a recorrência não tem prazo.
  startsOn   String  @db.Char(7)
  endsOn     String? @db.Char(7)
  active     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner       User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  person      Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  obligations Obligation[]

  @@index([ownerUserId, active])
}

// ---------------------------------------------------------------------------
// Cartão de crédito
// ---------------------------------------------------------------------------

model CreditCard {
  id String @id @default(uuid())

  ownerUserId String
  name        String
  brand       String?
  /// Apenas os quatro últimos dígitos. Número completo, CVV e validade não entram no
  /// banco — minimização exigida pela LGPD e o que evita que um vazamento vire fraude.
  lastFour    String? @db.Char(4)
  closingDay  Int
  dueDay      Int
  active      Boolean @default(true)
  /// Cartão usado por mais de uma pessoa. Não muda a regra — todo lançamento continua
  /// podendo ser repassado —, mas diz à tela de classificação que separar responsáveis é
  /// o caso comum ali, e não a exceção.
  shared      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  imports      ImportBatch[]
  installments Installment[]

  @@index([ownerUserId])
}

model Invoice {
  id     String @id @default(uuid())
  cardId String
  /// Mês de referência no formato YYYY-MM. String em vez de data para não depender de
  /// fuso: "a fatura de agosto" é a mesma em qualquer timezone, um DateTime não é.
  referenceMonth String @db.Char(7)
  /// Quando a fatura fecha: depois disso a compra vai para a fatura seguinte. É o que
  /// permite sugerir a fatura de destino de cada lançamento a partir da data da compra.
  closingDate    DateTime
  dueDate        DateTime

  status InvoiceStatus @default(OPEN)
  total  Decimal       @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card    CreditCard     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  entries InvoiceEntry[]

  @@unique([cardId, referenceMonth])
  @@index([status])
}

/// Compra parcelada, com vida própria além das parcelas.
///
/// Existe como tabela para responder "quanto ainda devo desta compra" sem varrer faturas,
/// e para reconhecer, na importação do mês seguinte, que aquela parcela já foi gerada —
/// sem isso, cada extrato traria a mesma compra de novo e ela seria lançada em dobro.
model Installment {
  id     String @id @default(uuid())
  cardId String

  description String
  /// Normalizada, e é por ela que a importação do mês seguinte reconhece o parcelamento.
  descriptionKey String
  /// Valor de cada parcela e quantidade total. O total da compra é o produto dos dois.
  amount         Decimal @db.Decimal(14, 2)
  installments   Int
  /// Mês da primeira parcela lançada aqui — pode não ser a parcela 1, se o parcelamento
  /// já estava em curso quando o cartão entrou no sistema.
  firstMonth     String  @db.Char(7)
  firstNumber    Int
  /// Nulo significa "meu": a compra é do dono do cartão.
  responsiblePersonId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  card        CreditCard     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  responsible Person?        @relation(fields: [responsiblePersonId], references: [id], onDelete: SetNull)
  entries     InvoiceEntry[]

  /// Um parcelamento por (cartão, descrição, quantidade, primeira parcela). É esta chave
  /// que faz a reimportação reconhecer o que já existe em vez de criar outro plano.
  @@unique([cardId, descriptionKey, installments, firstMonth])
  @@index([cardId])
}

/// Pagamento de um título financeiro.
///
/// Tabela própria, e não um par de colunas na obrigação, porque um título pode ser pago em
/// partes e em datas diferentes — metade no dia 5, o resto no dia 20. Com colunas, a
/// segunda data sobrescreveria a primeira e o histórico do que foi pago se perderia.
///
/// A observação existe porque a explicação costuma ser o que resolve a dúvida meses
/// depois: "paguei em dinheiro", "o Bruno me pagou por Pix".
model Payment {
  id           String   @id @default(uuid())
  obligationId String
  amount       Decimal  @db.Decimal(14, 2)
  paidAt       DateTime
  note         String?

  /// Falso enquanto o pagamento aguarda a palavra de quem recebe.
  ///
  /// Numa dívida entre duas pessoas, quem deve pode registrar que pagou, mas quem recebe é
  /// quem sabe se o dinheiro chegou. Até a confirmação o pagamento existe e aparece para os
  /// dois lados, e **não** entra na soma que abate a dívida — deixar entrar permitiria
  /// quitar a dívida de si mesmo declarando um pagamento que ninguém viu.
  ///
  /// O padrão é `true` porque o caso comum é quem recebe dando a baixa, e porque todo
  /// pagamento que já existia foi registrado por alguém com autoridade para isso.
  confirmed Boolean @default(true)

  /// Verdadeiro quando a linha é **acerto**, e não dinheiro: o desconto que fecha um
  /// título pago a menor.
  ///
  /// Ela abate a dívida como qualquer pagamento — é isso que faz o título quitar —, mas
  /// fica de fora do saldo da conta bancária, porque nada saiu do banco. Sem a distinção,
  /// conceder um desconto tiraria dinheiro do saldo do mesmo jeito que pagá-lo.
  ///
  /// Juros e multa não precisam de marca: são dinheiro de verdade e entram como pagamento
  /// comum, maior que o título.
  adjustment Boolean @default(false)

  /// Por onde o dinheiro passou. Nulo quando não se sabe — é o que mantém a baixa
  /// possível para quem ainda não cadastrou conta nenhuma.
  accountId String?

  /// Preenchidos quando o pagamento veio do CSV da fatura, e é o par com a obrigação que
  /// torna a reimportação idempotente.
  dedupeHash    String?
  importBatchId String?

  createdAt DateTime @default(now())

  obligation  Obligation   @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  account     BankAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([obligationId, dedupeHash])
  @@index([obligationId, paidAt])
  @@index([obligationId, confirmed])
  @@index([accountId, paidAt])
  @@index([paidAt])
}

model InvoiceEntry {
  id          String   @id @default(uuid())
  invoiceId   String
  date        DateTime
  description String
  amount      Decimal  @db.Decimal(14, 2)

  installmentNumber Int?
  installmentTotal  Int?
  /// Liga a parcela ao plano de parcelamento que a gerou.
  installmentId     String?
  /// Verdadeiro nas parcelas futuras criadas na importação, que ainda não apareceram em
  /// nenhum extrato. É o que permite reconhecê-las quando o extrato do mês chegar.
  projected         Boolean @default(false)

  /// Chave de deduplicação derivada da linha do CSV. O par (invoiceId, dedupeHash) é
  /// único no banco: é isso que torna a reimportação da mesma fatura idempotente mesmo
  /// sob concorrência. Checar-antes-de-inserir no código teria race condition.
  dedupeHash String

  /// Preenchido quando o gasto foi repassado a um terceiro — gera o "a receber".
  forwardedToPersonId String?
  importBatchId       String?

  /// Em que se gastou. Fica aqui, e não na obrigação, porque a obrigação do cartão é a
  /// **fatura inteira** — categorizar ali só permitiria dizer "mil reais de cartão", que
  /// não responde nada. A pergunta que a categoria existe para responder é em que o mês
  /// foi gasto, e isso só a linha do extrato sabe.
  categoryId String?

  createdAt DateTime @default(now())

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  forwardedTo Person?      @relation(fields: [forwardedToPersonId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  installment Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, dedupeHash])
  @@index([categoryId])
  @@index([installmentId])
  @@index([invoiceId, date])
  @@index([forwardedToPersonId])
}

/// Auditoria de cada importação de CSV.
///
/// Guarda o que foi ignorado, não só o que entrou. O README manda ignorar em silêncio o
/// pagamento de fatura que já não está aberta — silêncio para o usuário, não amnésia para
/// o sistema: sem este registro, "sumiu um pagamento" vira investigação sem pista.
model ImportBatch {
  id     String @id @default(uuid())
  cardId String
  userId String

  fileName        String
  /// Hash do arquivo inteiro, para reconhecer o mesmo CSV enviado de novo.
  fileHash        String
  rowsTotal       Int    @default(0)
  rowsInserted    Int    @default(0)
  rowsSkipped     Int    @default(0)
  paymentsIgnored Int    @default(0)

  createdAt DateTime @default(now())

  card     CreditCard       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries  InvoiceEntry[]
  payments Payment[]

  @@index([cardId, createdAt])
}

// ---------------------------------------------------------------------------
// Rateio de grupo
// ---------------------------------------------------------------------------

model Group {
  id          String   @id @default(uuid())
  name        String
  ownerUserId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  events      GroupEvent[]
  settlements Settlement[]

  @@index([ownerUserId])
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String
  personId String
  joinedAt DateTime @default(now())

  group  Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([groupId, personId])
}

/// Um rolê: o evento onde as despesas aconteceram.
model GroupEvent {
  id      String   @id @default(uuid())
  groupId String
  name    String
  date    DateTime

  createdAt DateTime @default(now())

  group    Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expenses GroupExpense[]

  @@index([groupId, date])
}

model GroupExpense {
  id            String        @id @default(uuid())
  eventId       String
  /// Quem pagou pelos demais.
  payerPersonId String
  description   String
  amount        Decimal       @db.Decimal(14, 2)
  paymentMethod PaymentMethod

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  GroupEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payer  Person         @relation(fields: [payerPersonId], references: [id], onDelete: Cascade)
  shares ExpenseShare[]

  @@index([eventId])
  @@index([payerPersonId])
}

/// Quanto da despesa cabe a cada participante.
///
/// Guarda valor absoluto, não percentual: a soma das shares tem de bater exatamente com
/// o valor da despesa, e percentual sobre um valor que não divide exato (R$ 10,00 entre 3)
/// perde centavos no arredondamento — centavo perdido é saldo que nunca fecha.
model ExpenseShare {
  id        String  @id @default(uuid())
  expenseId String
  personId  String
  amount    Decimal @db.Decimal(14, 2)

  expense GroupExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  person  Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([expenseId, personId])
}

/// Fechamento do mês: resolve quem paga quem.
model Settlement {
  id      String @id @default(uuid())
  groupId String
  /// YYYY-MM, mesmo motivo do referenceMonth da fatura.
  period  String @db.Char(7)

  status   SettlementStatus @default(OPEN)
  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group     Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  transfers SettlementTransfer[]

  @@unique([groupId, period])
}

model SettlementTransfer {
  id           String  @id @default(uuid())
  settlementId String
  fromPersonId String
  toPersonId   String
  amount       Decimal @db.Decimal(14, 2)

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  from       Person     @relation("TransferenciaOrigem", fields: [fromPersonId], references: [id], onDelete: Cascade)
  to         Person     @relation("TransferenciaDestino", fields: [toPersonId], references: [id], onDelete: Cascade)

  @@index([settlementId])
}

// ---------------------------------------------------------------------------
// Categoria, orçamento por categoria e conta bancária
// ---------------------------------------------------------------------------

/// Tipo de conta onde o dinheiro fica. Vale-alimentação entra porque é forma de
/// pagamento no domínio, e sem conta própria o saldo dele se misturaria ao da corrente.
enum AccountKind {
  CHECKING
  SAVINGS
  WALLET
  MEAL_VOUCHER
}

/// Classificação de um lançamento: "Mercado", "Aluguel", "Salário".
///
/// A categoria é do **usuário**, não global: cada um organiza as próprias contas do jeito
/// que pensa nelas, e uma lista imposta viraria a categoria "Outros" levando metade dos
/// lançamentos.
model Category {
  id      String @id @default(uuid())
  ownerId String

  name String
  /// Hex, para o gráfico e a etiqueta. Nulo usa a cor neutra do tema.
  color String?
  /// Nulo quando serve aos dois lados — "Transporte" pode ser gasto e reembolso.
  direction Direction?

  /// Arquivada sai das listas de escolha e continua nos lançamentos antigos. Excluir
  /// deixaria o histórico sem classificação, que é o oposto do motivo de existir.
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  obligations    Obligation[]
  recurrences    Recurrence[]
  budgets        CategoryBudget[]
  invoiceEntries InvoiceEntry[]

  @@unique([ownerId, name])
  @@index([ownerId, archived])
}

/// Meta ou limite de uma categoria.
///
/// `month` nulo é o valor **padrão**, que vale para todo mês sem ajuste próprio. Com ele,
/// definir o limite de mercado uma vez basta — e o mês do Natal ainda pode ter o seu.
model CategoryBudget {
  id         String  @id @default(uuid())
  categoryId String
  month      String? @db.Char(7)
  amount     Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month])
}

/// Onde o dinheiro fica: corrente, poupança, carteira, vale.
///
/// O saldo **não** é campo: é `initialBalance` mais a soma dos pagamentos que passaram
/// por ela. Guardar o saldo faria ele divergir do extrato no primeiro estorno, e a
/// divergência só apareceria quando alguém conferisse — tarde demais.
model BankAccount {
  id      String @id @default(uuid())
  ownerId String

  name           String
  kind           AccountKind @default(CHECKING)
  /// O saldo no dia em que a conta entrou no sistema. O histórico anterior não existe aqui.
  initialBalance Decimal     @default(0) @db.Decimal(14, 2)
  archived       Boolean     @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([ownerId, name])
  @@index([ownerId, archived])
}

// ---------------------------------------------------------------------------
// Histórico de fechamento por participante
// ---------------------------------------------------------------------------

/// O registro de um acerto de contas com uma pessoa.
///
/// Antes disto o fechamento existia só como número no contador e como texto na observação
/// das baixas: dava para saber que houve, e não o que entrou nele. O registro é o que
/// permite reabrir o papel meses depois com os mesmos números.
model ParticipantSettlement {
  id       String @id @default(uuid())
  ownerId  String
  personId String

  /// Sequencial por usuário. É o número que aparece no papel.
  number Int
  month  String @db.Char(7)

  totalReceivable Decimal @db.Decimal(14, 2)
  totalPayable    Decimal @db.Decimal(14, 2)
  /// A receber − a pagar. Positivo: o participante ficou devendo.
  balance         Decimal @db.Decimal(14, 2)

  /// A obrigação criada com a diferença, quando houve.
  adjustmentId String?

  settledAt DateTime
  createdAt DateTime @default(now())

  owner   User                         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  person  Person                       @relation(fields: [personId], references: [id], onDelete: Cascade)
  entries ParticipantSettlementEntry[]

  @@unique([ownerId, number])
  @@index([ownerId, personId, month])
}

/// Um título que entrou num fechamento, com o valor que ele tinha ali.
///
/// O valor é copiado, e não lido da obrigação: o título pode ser editado depois, e o papel
/// assinado precisa continuar batendo com o que foi assinado.
model ParticipantSettlementEntry {
  id           String  @id @default(uuid())
  settlementId String
  obligationId String
  description  String
  amount       Decimal @db.Decimal(14, 2)
  receivable   Boolean

  settlement ParticipantSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
}

/// A combinação de fechar com alguém todo mês — o aluguel rachado, a internet dividida.
///
/// Não dispara nada sozinho: marca a data a partir da qual o fechamento daquele mês está
/// pronto, e o sistema avisa. Fechar por conta própria quitaria títulos sem ninguém
/// conferir, e a conferência é a razão de o fechamento existir.
model SettlementSchedule {
  id       String @id @default(uuid())
  ownerId  String
  personId String @unique

  /// Dia do mês a partir do qual o acerto daquele mês é cobrado na tela.
  dayOfMonth Int     @default(1)
  active     Boolean @default(true)
  /// Último mês já fechado por esta agenda, em YYYY-MM. Evita cobrar o que já foi feito.
  lastMonth  String? @db.Char(7)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner  User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([ownerId, active])
}

/// Confirmação de leitura de um aviso.
///
/// Os avisos continuam **derivados** — não há tabela de notificação. O que se guarda aqui é
/// só a leitura: qual aviso a pessoa disse ter visto, e em que estado ele estava.
///
/// A `assinatura` é o que impede a confirmação de virar um silenciador permanente. Ela
/// resume o conteúdo do aviso (o detalhe e o valor); se o motivo mudar — a dívida atrasada
/// que recebeu um pagamento parcial e agora cobra outro valor — a assinatura muda junto e o
/// aviso volta a aparecer. Sem isso, marcar "Aluguel atrasado" como lido calaria aquele
/// aluguel para sempre, inclusive quando ele voltasse a ser outra coisa.
model NoticeRead {
  id      String @id @default(uuid())
  userId  String
  /// O id derivado do aviso: estável para a mesma causa (`venc-<id>`, `limite-<cat>-<mês>`).
  noticeId   String
  assinatura String

  readAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeId])
  @@index([userId])
}
