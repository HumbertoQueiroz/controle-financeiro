{
  "name": "controle-financeiro",
  "version": "0.1.0",
  "private": true,
  "description": "Controle financeiro por usuário: cartão de crédito com importação de fatura e rateio de gastos entre amigos",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:e2e": "pnpm --filter @controle/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "pnpm --filter @controle/api db:migrate",
    "db:deploy": "pnpm --filter @controle/api db:deploy",
    "db:seed": "pnpm --filter @controle/api db:seed",
    "db:studio": "pnpm --filter @controle/api db:studio",
    "db:reset": "pnpm --filter @controle/api db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
